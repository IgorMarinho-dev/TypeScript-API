generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Paciente {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Medico {
  id            Int      @id @default(autoincrement())
  nome          String
  telefone      String
  especialidade String
  crm           String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}