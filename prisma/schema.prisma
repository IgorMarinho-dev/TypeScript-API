generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Paciente {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String
  consultas Consulta[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Medico {
  id            Int      @id @default(autoincrement())
  nome          String
  telefone      String
  especialidade String
  crm           String   @unique
  consultas     Consulta[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Consulta {
  id         Int      @id @default(autoincrement())
  data       DateTime
  turno      String
  medicoId   Int
  pacienteId Int
  medico     Medico   @relation(fields: [medicoId], references: [id])
  paciente   Paciente @relation(fields: [pacienteId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([medicoId])
  @@index([pacienteId])
}
